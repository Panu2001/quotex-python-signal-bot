
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paper Lab (persistent SQLite paper-trading & self-learning service)
# Store durable SQLite database and model artifacts outside temp/session directories:
PAPER_LAB_DATA_DIR=""
# Optional path to JSON config file (see python_bot/paper_lab_config.sample.json):
PAPER_LAB_CONFIG=""
# Optional initial local dashboard account credentials (hashed with PBKDF2 in SQLite):
PAPER_LAB_USERNAME="trader"
PAPER_LAB_PASSWORD=""
# Telegram Bot Token is read ONLY from env or external secret file (never stored in SQLite):
TELEGRAM_BOT_TOKEN=""


